---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Hugo Gonçalves — personal site.' } = Astro.props;
const pageTitle = title === 'Hugo Gonçalves' ? title : `${title} • Hugo Gonçalves`;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- Correção: Injeta o baseUrl nos ficheiros estáticos da pasta public -->
    <link rel="icon" href={`${baseUrl}avatar.png`} type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="Hugo Gonçalves" href={`${baseUrl}rss.xml`} />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
