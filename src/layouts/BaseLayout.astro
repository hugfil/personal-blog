---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = 'Hugo Gonçalves, team lead and senior software testing consultant. Writing about testing, automation, BDD and bringing AI into QA work.',
  type,
  image,
  pubDate,
  updatedDate,
  tags,
  noindex,
} = Astro.props;
const pageTitle = title === 'Hugo Gonçalves' ? title : `${title} • Hugo Gonçalves`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={pageTitle}
      headline={title}
      description={description}
      type={type}
      image={image}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      noindex={noindex}
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Hugo Gonçalves" href="/rss.xml" />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Cloudflare Web Analytics (no cookies). Loads only on the live site,
         so local visits and the Playwright/Lighthouse runs are never counted. -->
    <script is:inline>
      if (location.hostname === 'hugogoncalves.dev') {
        const beacon = document.createElement('script');
        beacon.defer = true;
        beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        beacon.dataset.cfBeacon = JSON.stringify({ token: '6f52d331a31746479bcbf5a214b3196d' });
        document.body.appendChild(beacon);
      }
    </script>
  </body>
</html>
