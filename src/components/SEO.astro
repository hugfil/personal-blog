---
// All <head> tags that matter for search engines and link previews
// (Google, LinkedIn, Slack, WhatsApp...). Used once, in BaseLayout.

interface Props {
  title: string;
  // Title without the " • Hugo Gonçalves" suffix, for link previews and JSON-LD.
  headline?: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  headline = title,
  description,
  type = 'website',
  image = '/og-image.png', // 1200x630, made for link previews
  pubDate,
  updatedDate,
  tags = [],
  noindex = false,
} = Astro.props;

const SITE_NAME = 'Hugo Gonçalves';

// Always the hugogoncalves.dev version of the current page, so there is only one URL per page.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isHome = Astro.url.pathname === '/';

const person = {
  '@type': 'Person',
  name: SITE_NAME,
  url: Astro.site?.toString(),
  image: new URL('/avatar.png', Astro.site).toString(),
  jobTitle: 'Team Lead | Senior Software Testing Consultant',
  worksFor: { '@type': 'Organization', name: 'Noesis', url: 'https://www.noesis.pt/' },
};

const jsonLd =
  type === 'article' && pubDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline,
        description,
        url: canonicalURL.toString(),
        image: imageURL.toString(),
        datePublished: pubDate.toISOString(),
        dateModified: (updatedDate ?? pubDate).toISOString(),
        keywords: tags.length ? tags.join(', ') : undefined,
        author: person,
      }
    : isHome
      ? { '@context': 'https://schema.org', ...person }
      : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_NAME} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalURL} />}

<!-- Open Graph: link previews on LinkedIn, Slack, WhatsApp, Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={headline} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{image === '/og-image.png' && <meta property="og:image:width" content="1200" />}
{image === '/og-image.png' && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={SITE_NAME} />
{type === 'article' && <meta property="article:author" content={SITE_NAME} />}
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={headline} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
