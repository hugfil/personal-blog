---
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      prevNote: notes[index + 1] ?? null,
      nextNote: notes[index - 1] ?? null,
    },
  }));
}

const { note, prevNote, nextNote } = Astro.props;
const { Content } = await render(note);

// Notes have no description field: use the start of the text for search results and link previews.
const plain = (note.body ?? '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '') // images
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // links -> text
  .replace(/[#*_`>]/g, '') // markdown symbols
  .replace(/\s+/g, ' ')
  .trim();
const description = plain.length > 155 ? `${plain.slice(0, 152).trimEnd()}…` : plain;
---

<EntryLayout
  title={note.data.title}
  description={description || undefined}
  pubDate={note.data.pubDate}
  tags={note.data.tags}
  backHref="/notes/"
  backLabel="all notes"
  prevEntry={prevNote && { title: prevNote.data.title, href: `/notes/${prevNote.id}/` }}
  nextEntry={nextNote && { title: nextNote.data.title, href: `/notes/${nextNote.id}/` }}
>
  <Content />
</EntryLayout>
