---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };

const byYear = new Map<number, typeof notes>();
for (const note of notes) {
  const year = note.data.pubDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(note);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Notes">
  <h1>Notes</h1>
  <p class="entry-meta">Shorter and more informal than blog posts.</p>
  {years.map((year) => (
    <section class="year-group">
      <h2 class="year-heading">{year}</h2>
      <ul class="entry-list">
        {byYear.get(year)!.map((note) => (
          <li>
            <a class="entry-title" href={`/notes/${note.id}/`}>{note.data.title}</a>
            <time datetime={note.data.pubDate.toISOString()}>
              {note.data.pubDate.toLocaleDateString('en-US', dateFormat)}
            </time>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
