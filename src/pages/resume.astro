---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resume">
  <h1>Resume</h1>
  <p>
    <a class="content-link" href="/resume.pdf">Download PDF</a> — or drop your own
    <code>resume.pdf</code> into <code>public/</code> to make this link work.
  </p>

  <h2>Experience</h2>
  <h3>Job Title — Company</h3>
  <p class="entry-meta">2024 — present</p>
  <ul>
    <li>What you did, in one line.</li>
    <li>An impact or result, if you have one.</li>
  </ul>

  <h2>Education</h2>
  <h3>Degree — Institution</h3>
  <p class="entry-meta">Year — Year</p>

  <h2>Skills</h2>
  <p>Comma-separated list, or group by category — up to you.</p>
</BaseLayout>
