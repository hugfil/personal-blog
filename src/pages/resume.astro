---
import Layout from '../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

// Formação ordena pelo ano de fim; Experiência pelo ano de início.
// Sem "fim" (ainda a decorrer) conta como o mais recente.
const chave = (e: CollectionEntry<'resume'>) =>
  e.data.tipo === 'formacao' ? (e.data.fim ?? 9999) : e.data.inicio;

const entradas = (await getCollection('resume')).sort((a, b) => {
  if (a.data.destaque !== b.data.destaque) return a.data.destaque ? -1 : 1;
  return chave(b) - chave(a) || b.data.inicio - a.data.inicio;
});

const comConteudo = await Promise.all(
  entradas.map(async (e) => ({ ...e, Content: (await render(e)).Content }))
);

const secoes = [
  { id: 'experiencia', titulo: 'Experience' },
  { id: 'formacao', titulo: 'Education' },
];
---

<Layout title="Resume">
  {secoes.map((s) => (
    <section class="cv-secao">
      <h2>{s.titulo}</h2>
      <div class="cv-grelha">
        {comConteudo
          .filter((e) => e.data.tipo === s.id)
          .map(({ data, Content }) => (
            <article class:list={['cv-cartao', { 'cv-destaque': data.destaque }]}>
              <header class="cv-topo">
                <span class="cv-selo">
                  {!data.fim && <span class="cv-agora" aria-hidden="true" />}
                  {data.tipo === 'formacao'
                    ? (data.fim ?? 'present')
                    : `${data.inicio} – ${data.fim ?? 'present'}`}
                </span>
                {data.logo && (
                  <img class="cv-logo" src={data.logo} alt="" loading="lazy" />
                )}
              </header>
              <h3>{data.titulo}</h3>
              <p class="cv-local">{data.local}</p>
              <div class="cv-corpo"><Content /></div>
              {data.tags.length > 0 && (
                <ul class="cv-tags">
                  {data.tags.map((t) => <li class="cv-tag">{t}</li>)}
                </ul>
              )}
            </article>
          ))}
      </div>
    </section>
  ))}
  <p class="cv-pdf-rodape">
    <a class="cv-pdf" href="/personal-blog/404">
      Full CV (PDF) <span aria-hidden="true">↓</span>
    </a>
  </p>
</Layout>

<style>
  .cv-secao { margin-top: 2.5rem; }

  .cv-secao h2 {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .cv-grelha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .cv-cartao {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .cv-cartao:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* cartão em destaque: largura total e um toque de cor */
  .cv-destaque {
    grid-column: 1 / -1;
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--code-bg));
  }
  .cv-destaque h3 { font-size: 1.25rem; }

  .cv-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .cv-selo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* bolinha a pulsar nos cargos em curso */
  .cv-agora {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    animation: cv-pulso 2s ease-in-out infinite;
  }
  @keyframes cv-pulso {
    50% { opacity: 0.25; }
  }

  /* logótipo em avatar redondo (símbolo claro sobre fundo transparente) */
  .cv-logo {
    width: 60px;
    height: 60px;
    padding: 2px;
    flex-shrink: 0;
    object-fit: contain;
    border: 1px solid color-mix(in srgb, var(--text-muted) 45%, transparent);
    border-radius: 50%;
    filter: grayscale(1) invert(1); /* modo claro: símbolo passa a escuro */
  }
  :global(:root[data-theme="dark"]) .cv-logo {
    filter: grayscale(1); /* modo escuro: mantém o símbolo claro */
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .cv-logo {
      filter: grayscale(1);
    }
  }

  .cv-cartao h3 { margin: 0; font-size: 1.05rem; }
  .cv-local { margin: 0.15rem 0 0.75rem; color: var(--text-muted); }

  /* o conteúdo do Markdown vem de outro componente, por isso precisa de :global */
  .cv-corpo :global(p) { margin: 0 0 0.5rem; }
  .cv-corpo :global(ul) { margin: 0; padding-left: 1.1rem; }
  .cv-corpo :global(li) { margin: 0.25rem 0; }

  .cv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cv-tag {
    font-size: 0.75rem;
    color: var(--text-muted);
    border: 1px solid color-mix(in srgb, var(--text-muted) 45%, transparent);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  .cv-pdf-rodape { margin: 2.5rem 0 1rem; }

  .cv-pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid color-mix(in srgb, var(--text-muted) 45%, transparent);
    border-radius: 999px;
    background: var(--code-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .cv-pdf:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-cartao { transition: none; }
    .cv-cartao:hover { transform: none; }
    .cv-agora { animation: none; }
    .cv-pdf { transition: none; }
  }

  @media print {
    .cv-cartao { break-inside: avoid; }
    .cv-cartao:hover { transform: none; }
    .cv-pdf-rodape { display: none; }
  }
</style>