---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };

// Obtém automaticamente o caminho correto da subpasta ('/personal-blog/')
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Hugo Gonçalves">
  <div class="hero">
    <img class="avatar" src={`${import.meta.env.BASE_URL}/avatar.png`} alt="Hugo Gonçalves" width="140" height="140" />
    <h1>Hugo Gonçalves</h1>
    <p>
      Write a short introduction about yourself here — what you do, what you're
      interested in, where to find you elsewhere. Edit this in
      <code>src/pages/index.astro</code>.
    </p>
  </div>

  <h2>Recent posts</h2>
  <ul class="entry-list">
    {posts.map((post) => (
      <li>
        <!-- Correção: Injeta a subpasta correta antes do link do post -->
        <a class="entry-title" href={`/personal-blog/blog/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', dateFormat)}
        </time>
      </li>
    ))}
  </ul>
  <!-- Correção: Injeta a subpasta correta no link para ver todos os posts -->
  <p><a class="content-link nav-link" href={`/personal-blog/blog/`}>all posts</a></p>
</BaseLayout>
