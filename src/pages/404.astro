---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <div class="error-container">
    <div class="error-content">
      <h1 class="error-code">404</h1>
      <h2>Oops! Page Not Found</h2>
      <p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>

      <div class="redirect-box">
        You will be automatically redirected to the homepage in a few seconds.
      </div>
      <br />
      <a href="/personal-blog/" class="btn-home">
        Take Me Home Now
        <span class="btn-arrow">&rarr;</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50vh;
    padding: 2rem 1.25rem;
    text-align: center;
  }

  .error-content {
    max-width: 32rem;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-muted);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .error-content h2 {
    font-size: 1.5rem;
    margin: 1rem 0 0.75rem;
    color: var(--text);
  }

  .error-content p {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .redirect-box {
    background: var(--code-bg);
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.65rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    display: inline-block;
  }

  .btn-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--text);
    color: var(--bg);
    border: none;
    padding: 0.8rem 1.9rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 10px 24px -10px var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
  }

  .btn-home:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px -8px var(--text);
    opacity: 0.9;
  }

  .btn-home:active {
    transform: translateY(-1px);
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .btn-home:hover .btn-arrow {
    transform: translateX(3px);
  }
</style>

<script is:inline>
  setTimeout(() => {
    window.location.href = '/personal-blog/';
  }, 5000);
</script>