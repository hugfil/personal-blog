---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Blog">
  <h1>Blog</h1>
  {years.map((year) => (
    <section class="year-group">
      <h2 class="year-heading">{year}</h2>
      <ul class="entry-list">
        {byYear.get(year)!.map((post) => (
          <li>
            <a class="entry-title" href={`/personal-blog/blog/${post.id}/`}>{post.data.title}</a>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', dateFormat)}
            </time>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
